<?xml version="1.0" encoding="utf-8"?>
<!-- Shop reality: the PC server is plain-http on the LAN
     (http://192.168.x.x:port) and the manifest allows it, so the app can
     reach the shop server. Internet API/tunnel traffic stays https; the
     base-config below still pins system CAs for everything else. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
