{
  "name": "distribuili",
  "version": "0.1.10",
  "description": "Distribuili — wholesale distribution ERP (Algeria)",
  "author": "Distribuili",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:setup": "prisma generate && prisma migrate dev && prisma db seed",
    "electron:build:main": "tsc -p tsconfig.electron.json && node scripts/obfuscate-electron.mjs",
    "electron:build": "npm run db:generate && npm run build && npm run electron:build:main",
    "electron:dist": "npm run db:sqlite:build && npm run electron:build && npm run electron:build:seed && npm run electron:prepare && electron-builder",
    "electron:prepare": "node scripts/electron-prepare.mjs",
    "electron:build:seed": "node scripts/build-sqlite-seed.mjs",
    "db:sqlite:schema": "node scripts/gen-sqlite-schema.mjs",
    "db:sqlite:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:sqlite:ddl": "node scripts/gen-sqlite-ddl.mjs",
    "db:sqlite:build": "npm run db:sqlite:schema && npm run db:sqlite:generate && npm run db:sqlite:ddl",
    "electron:dist:mac": "npm run electron:dist -- --mac --publish never",
    "electron:dist:win": "npm run electron:dist -- --win --x64 --publish never",
    "electron:dist:local:mac": "node scripts/set-mode.mjs local && npm run db:sqlite:build && npm run electron:build && npm run electron:build:seed && node scripts/electron-prepare.mjs --target=mac && electron-builder --mac --config electron-builder.local.yml --publish never",
    "electron:dist:local:win": "node scripts/set-mode.mjs local && npm run db:sqlite:build && npm run electron:build && npm run electron:build:seed && node scripts/fix-standalone-win.mjs --target=win && node scripts/electron-prepare.mjs --target=win && electron-builder --win --x64 --config electron-builder.local.yml --publish never",
    "dist:client:mac": "node scripts/dist-client.mjs --target=mac",
    "dist:client:win": "node scripts/dist-client.mjs --target=win",
    "fetch:cloudflared": "node scripts/fetch-cloudflared.mjs",
    "electron:dist:server:mac": "node scripts/set-mode.mjs server https://votre-domaine.com && npm run electron:build:main && electron-builder --mac --config electron-builder.server.yml --publish never",
    "electron:dist:server:win": "node scripts/set-mode.mjs server https://votre-domaine.com && npm run electron:build:main && electron-builder --win --x64 --config electron-builder.server.yml --publish never",
    "license:keys": "node scripts/gen-license-keys.mjs",
    "update:publish": "node scripts/upload-update.mjs",
    "bundle:publish": "node scripts/publish-bundle.mjs",
    "bundle:trial": "node scripts/trial-bundle.mjs",
    "deploy": "bash scripts/deploy.sh",
    "backup": "bash scripts/backup-docker.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/share": "^8.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "arabic-reshaper": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "html2canvas-pro": "^2.6.4",
    "jose": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet.offline": "^3.2.1",
    "localforage": "^1.10.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-intl": "^4.11.0",
    "node-machine-id": "^1.1.12",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "javascript-obfuscator": "^5.4.3",
    "local-ssl-proxy": "^2.0.5",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
