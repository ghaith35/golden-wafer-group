# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string (docker-compose.yml maps host 5459 -> container 5432)
DATABASE_URL="postgresql://distribuili:distribuili_dev_pass@localhost:5459/distribuili_dev"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-jwt-secret-min-32-chars-hex"

# ─── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
# COOKIE_SECURE=false  # uncomment for plain-http LAN servers
# Google Maps key (optional): enables all-clients markers on the Carte zone
# map. Without it, the map shows one client at a time + steppers.
# Get one at https://console.cloud.google.com/apis/credentials (Maps JavaScript API).
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ─── Production server (docker-compose.prod.yml) ────────────────────────────
# POSTGRES_PASSWORD="change-me"   # openssl rand -hex 16
# LICENSE_PRIVATE_KEY="..."      # node scripts/gen-license-keys.mjs (secret!)

# ─── Phone update channel (sync pull) ─────────────────────────────────────────
# Native shells older than this must reinstall the APK (breaking native change).
# MIN_NATIVE_VERSION_CODE="7"
# Critical web fix that phones must not dismiss: FORCE_WEB_UPDATE="1"

# ─── Offline desktop (Electron local build) ───────────────────────────────────
# DISTRIBUILI_DB=local  # SQLite via libSQL; default (unset/server) = PostgreSQL
SHADOW_DATABASE_URL="postgresql://distribuili:distribuili_dev_pass@localhost:5459/distribuili_shadow"
