generator client {
  provider = "prisma-client-js"
}

// Prisma 7: url lives in prisma.config.ts (PostgreSQL).
// Offline desktop uses prisma/schema.sqlite.prisma (generated, git-ignored).
datasource db {
  provider = "postgresql"
}

// ─── Auth / tenancy ──────────────────────────────────────────────────────────

enum UserRole {
  Admin
  Vendeur
  Livreur
}

enum CostingMethod {
  LAST
  AVERAGE
  FIFO
}

enum VanBindingMode {
  LOCKED
  PICK
}

enum LanguagePreference {
  fr
  ar
  en
}

model Company {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  address      String?
  email        String?
  /// Algerian fiscal IDs (shown on invoices / sheets).
  rc           String?
  nif          String?
  ai           String?
  nis          String?
  bankName     String?
  rib          String?
  logoUrl      String?
  /// Signature + stamp images printed on documents.
  signatureUrl String?
  stampUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users            User[]
  stores           Store[]
  customers        Customer[]
  suppliers        Supplier[]
  products         Product[]
  seasons          Season[]
  settings         CompanySettings?
  units            Unit[]
  priceTiers       PriceTier[]
  expenseTypes     ExpenseType[]
  secteurs         Secteur[]
  purchaseInvoices PurchaseInvoice[]
  supplierReturns  SupplierReturn[]
  stockBatches     StockBatch[]
  transfers        Transfer[]
  stockCounts      StockCount[]
  stockLosses      StockLoss[]
  sales            Sale[]
  threePackRules   ThreePackRule[]
  clientReturns    ClientReturn[]
  closedVisits     ClosedVisit[]
  tournees         Tournee[]
  tourneePlans     TourneePlan[]
  expenses         Expense[]
  employees        Employee[]
  versements       Versement[]
  distances        ClientDistance[]
  deposits         Deposit[]
  devices          Device[]
  syncOps          SyncOp[]
  dailyCloses      DailyClose[]

  @@map("companies")
}

model CompanySettings {
  id            String  @id @default(cuid())
  companyId     String  @unique
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  defaultLocale String  @default("ar")
  currency      String  @default("DZD")

  // ── Feature toggles (every toggle gates real logic + UI + reports) ──
  expiryEnabled           Boolean        @default(false)
  creditSalesEnabled      Boolean        @default(false)
  debtTrackingEnabled     Boolean        @default(true)
  remiseEnabled           Boolean        @default(false)
  depositsEnabled         Boolean        @default(false)
  multiDepotEnabled       Boolean        @default(false)
  costingMethod           CostingMethod  @default(FIFO)
  facturePro              Boolean        @default(false)
  posEnabled              Boolean        @default(false)
  vanBindingMode          VanBindingMode @default(LOCKED)
  oversellAllowed         Boolean        @default(true)
  pieceSalesEnabled       Boolean        @default(false)
  /// Transfers need an explicit receipt confirmation (declare → confirm).
  /// OFF = declare delivers straight to destination (single-step).
  transferConfirmRequired Boolean        @default(true)
  gpsEnabled              Boolean        @default(true)
  qrStrictMode            Boolean        @default(true)
  /// Thermal ticket paper width in mm (admin setting: "58" or "80").
  ticketWidth             String         @default("80")
  /// Thermal ticket language (admin setting: "ar" or "fr", default French).
  ticketLang              String         @default("fr")
  /// Purchase picker: only the chosen supplier's products (default ON).
  supplierFilterEnabled   Boolean        @default(true)
  /// 3pack: free-colis bonus rules (buy X get Y free). Admin-editable.
  threePackEnabled        Boolean        @default(false)
  /// Expected départ time for vans ("HH:MM", null = no late flag).
  workStartAt             String?
  /// A journée longer than this (hours) flags overtime on presence.
  maxDayHours             Float?         @default(10)
  /// Public internet domain for this install's phones
  /// (e.g. client1.distribuili.khiatadz.com, no scheme). The Devices setup QR
  /// uses it when set, so vans reach the PC through the tunnel from anywhere.
  remoteDomain            String?

  @@map("company_settings")
  /// One-time conversion of the old copy-forward tours into endless plans.
  tourPlansMigratedAt DateTime?
}

// ─── Settings-managed reference lists ────────────────────────────────────────

model Unit {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  symbol    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  baseFor     Product[]               @relation("BaseUnit")
  saleFor     Product[]               @relation("SaleUnit")
  purchaseFor Product[]               @relation("PurchaseUnit")
  conversions ProductUnitConversion[]

  @@unique([companyId, name])
  @@map("units")
}

model PriceTier {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  prices    ProductTierPrice[]
  qtyRungs  ProductQtyTier[]
  customers Customer[]
  sales     Sale[]

  @@unique([companyId, name])
  @@map("price_tiers")
}

model ExpenseType {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([companyId, name])
  @@map("expense_types")
}

/// National reference: 58 wilayas (global, seeded once — not per company).
model Wilaya {
  code   Int    @id
  nameFr String
  nameAr String

  secteurs  Secteur[]
  customers Customer[]
  suppliers Supplier[]
  userAreas UserArea[]
}

/// Secteur inside a wilaya, per company (dispatch + tournées operate on these).
model Secteur {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  wilayaCode Int
  wilaya     Wilaya   @relation(fields: [wilayaCode], references: [code], onDelete: Restrict)
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  customers Customer[]
  suppliers Supplier[]
  tournees  Tournee[]
  tourneePlans TourneePlan[]
  userAreas UserArea[]

  @@unique([companyId, wilayaCode, name])
  @@index([companyId, wilayaCode])
  @@map("secteurs")
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  username     String
  passwordHash String
  /// Staff phone number (login accepts username OR phone).
  phone        String?
  /// Admin-visible copy of the password (staff QR cards). Auth still uses
  /// bcrypt passwordHash; this column exists only so the admin can read it
  /// back on the Livreur / Pré-vendeur cards.
  passwordView String?
  /// Long-lived staff login token (QR cards + scan-to-login). Revocable via
  /// regenerate. Stored raw so cards can re-render the QR at any time.
  qrToken      String?  @unique
  fullName     String
  role         UserRole @default(Vendeur)
  isActive     Boolean  @default(true)
  /// Livreur / Vendeur may pick the journée day. false (default) = locked to
  /// today's tour only (admin toggles it in Settings > day access).
  canChooseDay Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  distances ClientDistance[]
  areas     UserArea[]

  assignedVans Store[]  @relation("AssignedVan")
  devices      Device[]
  closedVisits ClosedVisit[]
  createdSales Sale[]   @relation("CreatedSales")
  employee     Employee?

  @@unique([companyId, username])
  @@map("users")
}

/// Zones a Livreur / Pré-vendeur may create clients in (admin-assigned).
/// No rows for a user = unrestricted (sees every wilaya and secteur).
/// secteurId null = the whole wilaya; otherwise that single secteur only.
model UserArea {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wilayaCode Int
  wilaya     Wilaya   @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)
  secteurId  String?
  secteur    Secteur? @relation(fields: [secteurId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@map("user_areas")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model SuperAdminUser {
  id                String    @id @default(cuid())
  username          String    @unique
  passwordHash      String
  isActive          Boolean   @default(true)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())

  audits SuperAdminAudit[]

  @@map("super_admin_users")
}

/// Every superadmin action (who did what to which machine/key, when, from where).
model SuperAdminAudit {
  id         String         @id @default(cuid())
  adminId    String
  admin      SuperAdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime       @default(now())

  @@index([adminId, createdAt])
  @@map("super_admin_audits")
}

// ─── Distribution domain (minimal foundation) ────────────────────────────────

model Store {
  id                String       @id @default(cuid())
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  address           String?
  /// DEPOT = fixed warehouse, VAN = van stock (marque + matricule).
  kind              LocationKind @default(DEPOT)
  marque            String?
  matricule         String?
  /// Van photo (uploads/vans/…). Null = placeholder icon.
  imageUrl          String?
  userId            String?
  user              User?        @relation("AssignedVan", fields: [userId], references: [id], onDelete: SetNull)
  isActive          Boolean      @default(true)
  /// Live GPS tracking (APK reports via POST /api/track).
  lastLat           Float?
  lastLng           Float?
  lastSeenAt        DateTime?
  /// What the phone says about its own tracking health (permissions, battery…), JSON.
  lastTrackState String?
  /// Admin pressed "request location" (POST /api/vans/[id]/locate).
  /// The APK polls it and reports immediately; cleared on next report.
  locateRequestedAt DateTime?
  /// Per-van QR rules (Settings → QR): must the driver scan the client QR
  /// to sell / to create an order.
  qrSellRequired    Boolean      @default(true)
  qrOrderRequired   Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  batches       StockBatch[]
  transfersFrom Transfer[]     @relation("TransferFrom")
  transfersTo   Transfer[]     @relation("TransferTo")
  counts        StockCount[]
  losses        StockLoss[]
  sales         Sale[]
  clientReturns ClientReturn[]
  closedVisits  ClosedVisit[]
  tournees      Tournee[]
  tourneePlans  TourneePlan[]
  positions     VanPosition[]
  expenseLinks  Expense[]
  devices       Device[]
  dailyCloses   DailyClose[]

  /// One driver ↔ max one van (NULL userIds are always allowed).
  @@unique([companyId, userId])
  @@map("stores")
}

enum LocationKind {
  DEPOT
  VAN
}

enum TransferStatus {
  DECLARED
  CONFIRMED
  REJECTED
  CANCELLED
}

/// Declare → confirm transfer (depot↔van, van↔van, depot↔depot).
/// Stock leaves the source at declare (in-transit holding batches),
/// enters the destination only at confirm. Nothing moves silently.
model Transfer {
  id             String         @id @default(cuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId       String?
  number         String
  fromLocationId String
  fromLocation   Store          @relation("TransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocationId   String
  toLocation     Store          @relation("TransferTo", fields: [toLocationId], references: [id], onDelete: Restrict)
  status         TransferStatus @default(DECLARED)
  /// Cash the vendeur hands over with a van→depot return (versement link in Phase 6).
  cashAmount     Decimal        @default(0) @db.Decimal(14, 2)
  notes          String?
  declaredById   String?
  confirmedById  String?
  date           DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lines          TransferLine[]
  holdingBatches StockBatch[]   @relation("HoldingBatches")
  versements     Versement[]

  /// Offline idempotency key: the sync opId that declared this transfer.
  opId String?

  @@unique([companyId, number])
  @@unique([companyId, opId])
  @@index([companyId, status])
  @@map("transfers")
}

model TransferLine {
  id           String   @id @default(cuid())
  transferId   String
  transfer     Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  declaredQty  Decimal  @db.Decimal(14, 3)
  confirmedQty Decimal? @db.Decimal(14, 3)

  @@index([transferId])
  @@map("transfer_lines")
}

/// Physical stock count per location, then validated into adjustments.
enum CountStatus {
  DRAFT
  VALIDATED
}

model StockCount {
  id         String      @id @default(cuid())
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId   String?
  locationId String
  location   Store       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  number     String
  status     CountStatus @default(DRAFT)
  notes      String?
  date       DateTime    @default(now())
  createdAt  DateTime    @default(now())

  lines StockCountLine[]

  @@unique([companyId, number])
  @@index([companyId, locationId])
  @@map("stock_counts")
}

model StockCountLine {
  id          String     @id @default(cuid())
  countId     String
  count       StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  expectedQty Decimal    @db.Decimal(14, 3)
  countedQty  Decimal    @db.Decimal(14, 3)

  @@index([countId])
  @@map("stock_count_lines")
}

enum LossMotive {
  BREAKAGE
  EXPIRED
  GIFT
  LOSS
  OTHER
}

/// Breakage / loss / gift recording (consumes FIFO, decrements stock).
model StockLoss {
  id         String     @id @default(cuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId   String?
  locationId String
  location   Store      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  baseQty    Decimal    @db.Decimal(14, 3)
  motive     LossMotive
  notes      String?
  date       DateTime   @default(now())
  createdAt  DateTime   @default(now())

  @@index([companyId, locationId])
  @@map("stock_losses")
}

/// Monthly accounting period, auto-created (never manual, never deletable).
enum SeasonStatus {
  open
  closed
}

model Season {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  status    SeasonStatus @default(open)
  createdAt DateTime     @default(now())

  @@unique([companyId, year, month])
  @@map("seasons")
}

model Customer {
  id               String     @id @default(cuid())
  companyId        String
  company          Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Stable code: QR payload + printed cards (`CLT-0001…`).
  code             String
  legacyQr         String?
  name             String
  /// Portal username (unique per company).
  phone            String?
  address          String?
  wilayaCode       Int?
  wilaya           Wilaya?    @relation(fields: [wilayaCode], references: [code], onDelete: SetNull)
  secteurId        String?
  secteur          Secteur?   @relation(fields: [secteurId], references: [id], onDelete: SetNull)
  activityType     String?
  /// Optional fiscal identifiers (prefill the Bon de route / facture).
  rc               String?
  ai               String?
  nif              String?
  nis              String?
  rib              String?
  /// Sale price tier assigned at creation.
  tierId           String?
  tier             PriceTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  creditLimit      Decimal    @default(0) @db.Decimal(14, 2)
  creditDays       Int        @default(0)
  gpsLat           Float?
  gpsLng           Float?
  /// Bcrypt hash of the portal secret code (login = phone + secret).
  portalSecretHash String?
  balance          Decimal    @default(0) @db.Decimal(14, 2)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  /// Offline idempotency key: the sync opId that created this client.
  opId String?
  /// Staff member who registered this client (null = created before this was
  /// tracked, or imported). Drives the driver's "clients I created today" list.
  createdById String?

  distances ClientDistance[]
  closedVisits ClosedVisit[]

  sales        Sale[]
  returns      ClientReturn[]
  tourneeStops TourneeStop[]
  versements   Versement[]
  deposits     Deposit[]

  @@unique([companyId, code])
  @@unique([companyId, legacyQr])
  @@unique([companyId, phone])
  @@unique([companyId, opId])
  @@index([companyId, name])
  @@index([companyId, secteurId])
  @@map("customers")
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  address   String?
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  code             String?
  wilayaCode       Int?
  wilaya           Wilaya?           @relation(fields: [wilayaCode], references: [code], onDelete: SetNull)
  secteurId        String?
  secteur          Secteur?          @relation(fields: [secteurId], references: [id], onDelete: SetNull)
  notes            String?
  defaultProducts  Product[]         @relation("DefaultSupplier")
  purchaseInvoices PurchaseInvoice[]
  supplierReturns  SupplierReturn[]
  versements       Versement[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("suppliers")
}

model ProductCategory {
  id        String    @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime  @default(now())
  products  Product[]

  @@unique([companyId, name])
  @@map("product_categories")
}

model Product {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId     String?
  supplier       Supplier?        @relation("DefaultSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  name           String
  reference      String?
  barcode        String?
  /// Colisage: free text, e.g. "12 pcs/ctn".
  colisage       String?
  baseUnitId     String?
  baseUnit       Unit?            @relation("BaseUnit", fields: [baseUnitId], references: [id], onDelete: SetNull)
  /// Grossiste packaging: default unit used when buying / selling.
  /// Must be the base unit or one of this product's conversions.
  saleUnitId     String?
  saleUnit       Unit?            @relation("SaleUnit", fields: [saleUnitId], references: [id], onDelete: SetNull)
  purchaseUnitId String?
  purchaseUnit   Unit?            @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id], onDelete: SetNull)
  salePrice      Decimal          @default(0) @db.Decimal(14, 2)
  costPrice      Decimal          @default(0) @db.Decimal(14, 2)
  stockQty       Decimal          @default(0) @db.Decimal(14, 3)
  minStock       Decimal          @default(0) @db.Decimal(14, 3)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  images            ProductImage[]
  conversions       ProductUnitConversion[]
  tierPrices        ProductTierPrice[]
  qtyTiers          ProductQtyTier[]
  batches           StockBatch[]
  purchaseLines     PurchaseLine[]
  returnLines       SupplierReturnLine[]
  transferLines     TransferLine[]
  countLines        StockCountLine[]
  lossLines         StockLoss[]
  saleLines         SaleLine[]
  threePackItems    ThreePackItem[]
  clientReturnLines ClientReturnLine[]

  @@index([companyId, name])
  @@index([companyId, barcode])
  @@index([companyId, reference])
  @@map("products")
}

/// Swipe gallery: ordered image list per product.
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
  @@map("product_images")
}

/// 1 unit = factor × product base unit (e.g. 1 carton = 12 pièces).
model ProductUnitConversion {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  factor    Decimal  @db.Decimal(14, 3)
  /// Pack barcode: scanning it finds the product (sold in this pack unit).
  barcode   String?
  createdAt DateTime @default(now())

  @@unique([productId, unitId])
  @@index([barcode])
  @@map("product_unit_conversions")
}

/// Sale price per tier (détail / gros / super gros — customizable).
model ProductTierPrice {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  tierId    String
  tier      PriceTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  price     Decimal   @db.Decimal(14, 2)
  updatedAt DateTime  @updatedAt

  @@unique([productId, tierId])
  @@map("product_tier_prices")
}

/// Quantity ladder, per colisage: when a sale line of `unitKey` holds
/// qty >= minQty, it is priced with the product's `tier` price (tierId null =
/// the base "سعر البيع"). The active rung is the one with the greatest
/// minQty <= qty. Rungs reuse the existing tier prices — no new price numbers.
/// unitKey "" = the base unit; otherwise the Unit.id of the colisage.
model ProductQtyTier {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitKey   String     @default("")
  minQty    Decimal    @db.Decimal(14, 3)
  tierId    String?
  tier      PriceTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@unique([productId, unitKey, minQty])
  @@index([productId])
  @@map("product_qty_tiers")
}

// ─── Sales ───────────────────────────────────────────────────────────────────

enum SaleKind {
  ORDER
  DELIVERY
  INVOICE
  TICKET
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  INVOICED
  CANCELLED
}

enum SaleChannel {
  DEPOT
  VAN
  POS
}

/// ORDER = bon de commande (no stock move) → DELIVERY (stock out) → INVOICE.
/// TICKET = immediate van/POS cash sale (delivered + paid at once).
model Sale {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId    String?
  kind        SaleKind
  status      SaleStatus  @default(DRAFT)
  channel     SaleChannel @default(DEPOT)
  number      String
  clientId    String?
  client      Customer?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  locationId  String?
  location    Store?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  tierId      String?
  tier        PriceTier?  @relation(fields: [tierId], references: [id], onDelete: SetNull)
  /// Staff member who created the doc (vendeur order, van ticket). Null = back-office/legacy.
  createdById String?
  createdBy   User?       @relation("CreatedSales", fields: [createdById], references: [id], onDelete: SetNull)
  tourneeId   String?
  tournee     Tournee?    @relation(fields: [tourneeId], references: [id], onDelete: SetNull)
  /// Source doc in the chain (delivery ← order, invoice ← delivery).
  sourceId    String?
  source      Sale?       @relation("SaleChain", fields: [sourceId], references: [id], onDelete: SetNull)
  children    Sale[]      @relation("SaleChain")
  remise      Decimal     @default(0) @db.Decimal(14, 2)
  total       Decimal     @default(0) @db.Decimal(14, 2)
  /// Cash received at sale time (versement link in Phase 6).
  paid        Decimal     @default(0) @db.Decimal(14, 2)
  /// Van sale without QR scan while strict mode off.
  offList     Boolean     @default(false)
  qrScanned   Boolean     @default(false)
  /// Order placed by the client through the portal (staff validates).
  isPortal    Boolean     @default(false)
  /// Silent sale-site check (van tickets): GPS captured on the phone at
  /// sale time + distance to the client's registered position, for the
  /// admin only. Null = no fix (denied/offline) or client has no position.
  saleLat     Float?
  saleLng     Float?
  saleDistM   Float?
  /// Van tickets: null = ON HOLD (driver may edit / delete it), set = CONFIRMED (final,
  /// only an admin can edit or cancel it).
  confirmedAt DateTime?
  notes       String?
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lines   SaleLine[]
  returns ClientReturn[]

  /// Offline idempotency key: the sync opId that created this document.
  /// Unique per company → an offline sale can never be double-applied.
  opId String?

  @@unique([companyId, kind, number])
  @@unique([companyId, opId])
  @@index([companyId, clientId])
  @@index([companyId, status])
  @@map("sales")
}

model SaleLine {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitId    String?
  qty       Decimal @db.Decimal(14, 3)
  baseQty   Decimal @db.Decimal(14, 3)
  unitPrice Decimal @db.Decimal(14, 2)
  remise    Decimal @default(0) @db.Decimal(14, 2)
  lineTotal Decimal @db.Decimal(14, 2)
  /// Snapshot COGS at delivery (for margin reports).
  unitCost  Decimal @default(0) @db.Decimal(14, 2)
  /// 3pack gift line (price 0, stock still deducted).
  isBonus     Boolean @default(false)
  bonusRuleId String?

  @@index([saleId])
  @@map("sale_lines")
}

/// Client returns: restock + refund (cash) or debt credit.
enum RefundType {
  CASH
  DEBT_CREDIT
}

model ClientReturn {
  id         String     @id @default(cuid())
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId   String?
  clientId   String
  client     Customer   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  saleId     String?
  sale       Sale?      @relation(fields: [saleId], references: [id], onDelete: SetNull)
  locationId String
  location   Store      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  number     String
  refundType RefundType
  total      Decimal    @default(0) @db.Decimal(14, 2)
  notes      String?
  date       DateTime   @default(now())
  createdAt  DateTime   @default(now())

  lines ClientReturnLine[]

  /// Offline idempotency key: the sync opId that created this return.
  opId String?

  @@unique([companyId, number])
  @@unique([companyId, opId])
  @@index([companyId, clientId])
  @@map("client_returns")
}

model ClientReturnLine {
  id        String       @id @default(cuid())
  returnId  String
  ret       ClientReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  baseQty   Decimal      @db.Decimal(14, 3)
  unitPrice Decimal      @db.Decimal(14, 2)
  lineTotal Decimal      @db.Decimal(14, 2)

  @@index([returnId])
  @@map("client_return_lines")
}

// ─── Tournées ────────────────────────────────────────────────────────────────

enum TourneeStatus {
  OPEN
  CLOSED
}

/// Daily van visit list (admin-planned, vendeur-executed, optimized en route).
model Tournee {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date       DateTime
  locationId String
  location   Store         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  secteurId  String?
  secteur    Secteur?      @relation(fields: [secteurId], references: [id], onDelete: SetNull)
  status     TourneeStatus @default(OPEN)
  notes      String?
  /// Day tracking set by the livreur/vendeur: départ → fin de journée.
  startedAt  DateTime?
  finishedAt DateTime?
  /// GPS position captured at each stamp (best-effort, null when denied).
  startedLat Float?
  startedLng Float?
  finishedLat Float?
  finishedLng Float?
  /// Auto-close: started but never finished the same day — the system ends
  /// it at day end and flags it to the admin (driver didn't end journée).
  autoClosed Boolean @default(false)
  /// The recurring plan this day's tour was generated from (null = one-off).
  planId     String?
  plan       TourneePlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  /// Order inside the day: a van can run up to two tours per day (0, 1).
  slot       Int           @default(0)
  createdAt  DateTime      @default(now())

  stops TourneeStop[]
  sales Sale[]

  @@unique([planId, date])
  @@index([companyId, date])
  @@index([companyId, locationId])
  @@index([locationId, date])
  @@map("tournees")
}

model TourneeStop {
  id        String   @id @default(cuid())
  tourneeId String
  tournee   Tournee  @relation(fields: [tourneeId], references: [id], onDelete: Cascade)
  clientId  String
  client    Customer @relation(fields: [clientId], references: [id], onDelete: Cascade)
  position  Int      @default(0)
  visited   Boolean  @default(false)
  sold      Boolean  @default(false)
  skipped   Boolean  @default(false)
  total     Decimal  @default(0) @db.Decimal(14, 2)

  @@unique([tourneeId, clientId])
  @@map("tournee_stops")
}

// ─── Desktop licensing (server side — self-hosted, single business) ─────────

/// Known machines (informational registration from the desktop app).
/// status drives the poll: pending | activated | revoked. A machine row is
/// the server-side counterpart of the client's .lic files.
model Machine {
  id                  String    @id @default(cuid())
  machineId           String    @unique
  label               String?
  phone               String?
  specs               Json?
  status              String    @default("pending")
  token               String?
  activationKey       String?
  activationType      String    @default("machine")
  consumedByMachineId String?
  trialStart          DateTime?
  trialEnd            DateTime?
  activatedAt         DateTime?
  contactName         String?
  city                String?
  workshop            String?
  email               String?
  deviceSpecs         Json?
  trialIp             String?
  lastIp              String?
  lastSeen            DateTime  @default(now())
  createdAt           DateTime  @default(now())

  subscription MachineSubscription?

  @@index([status, createdAt])
  @@map("machines")
}

/// Billing posture per machine (manual for now — no payment provider).
/// expiry/suspension flips the same lock path as a manual revoke.
model MachineSubscription {
  id          String    @id @default(cuid())
  machineId   String    @unique
  machine     Machine   @relation(fields: [machineId], references: [machineId], onDelete: Cascade)
  plan        String    @default("standard")
  status      String    @default("trial")
  expiresAt   DateTime?
  graceEndsAt DateTime?
  activatedBy String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("machine_subscriptions")
}

/// Manually blocked IPs (abuse control). Blocks register/trial only —
/// never breaks an already-entitled install.
model BlockedIp {
  ip        String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("blocked_ips")
}

/// Human-readable activation keys (DILI-XXXX-XXXX-XXXX). Pool keys bind to
/// the first machine that redeems them; revoked keys kill the install.
model LicenseKey {
  id                  String   @id @default(cuid())
  machineId           String?
  label               String?
  humanKey            String   @unique
  revoked             Boolean  @default(false)
  /// Pool key consumed by another machine (resetKey restores it).
  consumedByMachineId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("license_keys")
}

/// One trial per machine.
model TrialIssue {
  machineId String   @id
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())

  @@map("trial_issues")
}

/// Vendor-side tunnel slots: one public hostname per client
/// (client1, client2…) pointing at the CLIENT's own PC via an outbound
/// connector (Cloudflare Tunnel). The vendor provisions the hostname +
/// credentials; client data never touches the vendor server, so a vendor
/// outage never stops a client (LAN + offline keep working).
model TunnelSlot {
  id              String   @id @default(cuid())
  subdomain       String   @unique
  domain          String
  label           String?
  status          String   @default("pending")
  tunnelId        String?
  /// Connector token for the client's PC (shown once, admin-only).
  token           String?
  clientMachineId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deployments     ClientDeployment[]

  @@map("tunnel_slots")
}

/// Vendor-side client deployments: one row per sold client version. The
/// worker (scripts/provision-worker) picks up `pending` rows and builds the
/// server side automatically: subdomain + port + database + nginx vhost +
/// tunnel pairing, then flips the row to `active` (or `failed`).
/// Domain rules (owner decisions, enforced below + in the API):
/// - `domain` (the FIRST/baked domain) is vendor-only: never returned to the
///   client, never editable, never deletable — the row itself has no DELETE
///   endpoint, only activate/deactivate.
/// - The client may set ONE override domain with their activation code only
///   (`domainOverride`); flipping `overrideActive` chooses which one serves.
model ClientDeployment {
  id              String   @id @default(cuid())
  client          String   @unique
  version         String
  domain          String
  domainOverride  String?
  overrideActive  Boolean  @default(false)
  /// Shop PC bound to this deployment (activation-code changes resolve here).
  machineId       String?
  tunnelSlotId    String?
  tunnelSlot      TunnelSlot? @relation(fields: [tunnelSlotId], references: [id], onDelete: SetNull)
  /// pending → provisioning | active | failed | deactivated
  status          String   @default("pending")
  lastError       String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("client_deployments")
}

// ─── Mobile sync ─────────────────────────────────────────────────────────────

/// One APK device, optionally locked to a van (vanBindingMode = LOCKED).
model Device {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label      String
  locationId String?
  location   Store?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  tokenHash  String    @unique
  lastSyncAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  ops SyncOp[]

  @@index([companyId])
  @@map("devices")
}

enum SyncOpStatus {
  APPLIED
  FAILED
}

/// Idempotent offline operation log (opId unique per company).
/// Failed ops stay visible for owner reconciliation.
model SyncOp {
  id         String       @id @default(cuid())
  companyId  String
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceId   String?
  device     Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  opId       String
  kind       String
  status     SyncOpStatus
  error      String?
  /// Created document id (sale/transfer/payment…) for reconciliation.
  resultId   String?
  /// Real action time on the phone (op envelope `occurredAt`), not sync time.
  occurredAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([companyId, opId])
  @@index([companyId, deviceId])
  @@map("sync_ops")
}

// ─── Purchases ───────────────────────────────────────────────────────────────

model PurchaseInvoice {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId   String?
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  number     String
  date       DateTime @default(now())
  /// Invoice-level remise (amount). Line remises live on lines.
  remise     Decimal  @default(0) @db.Decimal(14, 2)
  total      Decimal  @default(0) @db.Decimal(14, 2)
  /// Paid so far via invoice payments (versements linked below).
  paid       Decimal  @default(0) @db.Decimal(14, 2)
  notes      String?
  /// Optional photo of the supplier's paper invoice (stored as WebP).
  invoiceImageUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines    PurchaseLine[]
  returns  SupplierReturn[]
  payments Versement[]      @relation("InvoicePayments")

  @@unique([companyId, number])
  @@index([companyId, supplierId])
  @@map("purchase_invoices")
}

model PurchaseLine {
  id         String          @id @default(cuid())
  invoiceId  String
  invoice    PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  unitId     String?
  /// Qty in line unit + free units (supplier gifts).
  qty        Decimal         @db.Decimal(14, 3)
  freeQty    Decimal         @default(0) @db.Decimal(14, 3)
  /// Qty converted to product base unit (qty + freeQty) × factor.
  baseQty    Decimal         @db.Decimal(14, 3)
  unitPrice  Decimal         @db.Decimal(14, 2)
  remise     Decimal         @default(0) @db.Decimal(14, 2)
  lineTotal  Decimal         @db.Decimal(14, 2)
  expiryDate DateTime?
  batchId    String?         @unique
  batch      StockBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("purchase_lines")
}

/// FIFO/FEFO stock batches created at purchase (consumed by sales in Phase 5).
model StockBatch {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Null = main stock (Phase 4 backfills to the main depot).
  storeId    String?
  location   Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  /// Set while in-transit (declare→confirm holding).
  transferId String?
  transfer   Transfer? @relation("HoldingBatches", fields: [transferId], references: [id], onDelete: SetNull)
  qty        Decimal   @db.Decimal(14, 3)
  initialQty Decimal   @db.Decimal(14, 3)
  unitCost   Decimal   @db.Decimal(14, 2)
  expiryDate DateTime?
  createdAt  DateTime  @default(now())

  purchaseLine PurchaseLine?

  @@index([companyId, productId])
  @@index([productId, expiryDate])
  @@map("stock_batches")
}

/// Returns to supplier: restock reversal + supplier credit note (balance down).
model SupplierReturn {
  id         String           @id @default(cuid())
  companyId  String
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId   String?
  supplierId String
  supplier   Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceId  String?
  invoice    PurchaseInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  number     String
  date       DateTime         @default(now())
  total      Decimal          @default(0) @db.Decimal(14, 2)
  notes      String?
  createdAt  DateTime         @default(now())

  lines SupplierReturnLine[]

  @@unique([companyId, number])
  @@index([companyId, supplierId])
  @@map("supplier_returns")
}

model SupplierReturnLine {
  id        String         @id @default(cuid())
  returnId  String
  ret       SupplierReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  baseQty   Decimal        @db.Decimal(14, 3)
  unitPrice Decimal        @db.Decimal(14, 2)
  lineTotal Decimal        @db.Decimal(14, 2)

  @@index([returnId])
  @@map("supplier_return_lines")
}

model Expense {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId    String?
  typeId      String?
  type        ExpenseType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  /// Optional van link (fuel / maintenance per van).
  locationId  String?
  location    Store?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  label       String
  description String?
  amount      Decimal      @db.Decimal(14, 2)
  expenseDate DateTime     @default(now())
  createdAt DateTime     @default(now())
  deletedAt DateTime?

  /// Offline idempotency key: the sync opId that created this expense.
  opId String?

  @@index([companyId, expenseDate])
  @@index([companyId, typeId])
  @@unique([companyId, opId])
  @@map("expenses")
}

// ─── Employees (payroll) ─────────────────────────────────────────────────────

/// A staff user who is on the payroll (some drivers are not employees).
/// isActive=false keeps history but drops the person from payroll.
model Employee {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Fixed monthly salary.
  salary     Decimal   @default(0) @db.Decimal(14, 2)
  hireDate   DateTime  @default(now())
  endDate    DateTime?
  position   String?
  nationalId String?
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  advances EmployeeAdvance[]
  payslips Payslip[]

  @@index([companyId, isActive])
  @@map("employees")
}

/// Salary advance (سلفة). `remaining` shrinks as payslips deduct it (FIFO).
/// expenseId is a plain scalar (no FK): history must survive expense cleanup.
model EmployeeAdvance {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(14, 2)
  remaining  Decimal  @db.Decimal(14, 2)
  date       DateTime @default(now())
  note       String?
  expenseId  String?
  createdAt  DateTime @default(now())

  @@index([employeeId, date])
  @@index([companyId, date])
  @@map("employee_advances")
}

/// A PAID month for one employee (one row per employee+month, so a month can
/// never be paid twice). Previews are computed live and never stored.
model Payslip {
  id               String   @id @default(cuid())
  companyId        String
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year             Int
  month            Int
  baseSalary       Decimal  @db.Decimal(14, 2)
  bonus            Decimal  @default(0) @db.Decimal(14, 2)
  deduction        Decimal  @default(0) @db.Decimal(14, 2)
  deductionNote    String?
  advancesDeducted Decimal  @default(0) @db.Decimal(14, 2)
  net              Decimal  @db.Decimal(14, 2)
  paidAt           DateTime @default(now())
  expenseId        String?
  createdAt        DateTime @default(now())

  @@unique([employeeId, year, month])
  @@index([companyId, year, month])
  @@map("payslips")
}

// ─── Cash ────────────────────────────────────────────────────────────────────

enum VersementKind {
  CLIENT_PAYMENT
  SUPPLIER_PAYMENT
  CASH_COLLECTION
}

/// Cash-only money movements (per plan). Client/supplier payments move balances;
/// CASH_COLLECTION records van→depot handovers (auto-created on transfer confirm).
model Versement {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId          String?
  kind              VersementKind
  clientId          String?
  client            Customer?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  transferId        String?
  transfer          Transfer?        @relation(fields: [transferId], references: [id], onDelete: SetNull)
  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation("InvoicePayments", fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  /// Van/day attribution (till reconciliation): set when the money moves on
  /// a van — client payment collected on tour, or handover to the depot.
  /// Plain scalars (no FK): history must survive van/tournee cleanup.
  locationId        String?
  tourneeId         String?
  amount            Decimal          @db.Decimal(14, 2)
  date              DateTime         @default(now())
  notes             String?
  createdAt         DateTime         @default(now())

  /// Offline idempotency key: the sync opId that created this payment.
  opId String?

  @@unique([companyId, opId])
  @@index([companyId, date])
  @@index([companyId, clientId])
  @@index([companyId, supplierId])
  @@index([companyId, locationId, date])
  @@map("versements")
}

/// Daily van-till close (صندوق اليوم): expected vs collected vs remitted.
/// OPEN = computed live, nothing stored. DECLARED = livreur counted and
/// submitted his till (pending admin). CLOSED = admin snapshotted + locked.
enum DailyCloseStatus {
  DECLARED
  CLOSED
}

model DailyClose {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId       String?
  vanId          String
  van            Store            @relation(fields: [vanId], references: [id], onDelete: Cascade)
  /// Day at midnight (local). Unique per van-day.
  date           DateTime
  /// Snapshot taken at close (live-computed while open/declared).
  expected       Decimal          @default(0) @db.Decimal(14, 2)
  collected      Decimal          @default(0) @db.Decimal(14, 2)
  clientPayments Decimal          @default(0) @db.Decimal(14, 2)
  expenses       Decimal          @default(0) @db.Decimal(14, 2)
  returnsCash    Decimal          @default(0) @db.Decimal(14, 2)
  dueTotal       Decimal          @default(0) @db.Decimal(14, 2)
  /// Livreur-counted till, submitted for control.
  declared       Decimal?         @db.Decimal(14, 2)
  declaredById   String?
  declaredAt     DateTime?
  /// Accepted handover (CASH_COLLECTION versements).
  remitted       Decimal          @default(0) @db.Decimal(14, 2)
  /// remitted − (collected + clientPayments − expenses − returnsCash).
  difference     Decimal          @default(0) @db.Decimal(14, 2)
  status         DailyCloseStatus @default(DECLARED)
  closedById     String?
  closedAt       DateTime?
  notes          String?

  @@unique([companyId, vanId, date])
  @@index([companyId, date])
  @@map("daily_closes")
}

/// Client advances (toggle-gated, default OFF). Credits the client balance.
model Deposit {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seasonId  String?
  clientId  String
  client    Customer @relation(fields: [clientId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(14, 2)
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  @@index([companyId, clientId])
  @@map("deposits")
}

model DocumentSequence {
  id        String  @id @default(cuid())
  companyId String
  storeId   String?
  type      String
  year      Int
  nextNo    Int     @default(1)

  @@unique([companyId, storeId, type, year])
  @@map("document_sequences")
}

/// Per-user distance/time snapshot to every geolocated client.
/// Written on each "actualiser" (and manual entry); read back on open.
model ClientDistance {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    Customer @relation(fields: [clientId], references: [id], onDelete: Cascade)
  distanceM Float
  durationS Float
  atLat     Float
  atLng     Float
  /// "osrm" (road) or "estimate" (straight-line fallback).
  source    String   @default("estimate")
  updatedAt DateTime @updatedAt

  @@unique([companyId, userId, clientId])
  @@index([companyId, userId])
  @@map("client_distances")
}


// ─── 3pack: free-colis bonus rules ───────────────────────────────────────────
enum ThreePackMode {
  SINGLE
  PACK
  /// Buy X (single product or pack) → percentage off the target product(s).
  PERCENT
  /// Buy X (single product or pack) → the target product(s) get a new price.
  PRICE
}

enum ThreePackRole {
  BUY
  GIVE
}

/// SINGLE: buy X colis of P → Y colis of P free.
/// PACK: buy A×a + B×b (+ …) → fixed free colis. Every multiple counts.
/// Rules are deactivated, never hard-deleted (offline sales reference them).
model ThreePackRule {
  id        String          @id @default(cuid())
  companyId String
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  mode      ThreePackMode
  isActive  Boolean         @default(true)
  /// Editing a rule's products/quantities archives it and creates a new rule,
  /// so an offline sale always validates against the exact rule the phone had.
  isArchived Boolean        @default(false)
  /// Promotion window (inclusive, whole days). Null = open-ended. Past endsAt the
  /// rule is switched off automatically; before startsAt it does not apply yet.
  startsAt  DateTime?
  endsAt    DateTime?
  /// PERCENT rules: the % taken off every target product's line.
  percent   Decimal?        @db.Decimal(5, 2)
  createdAt DateTime        @default(now())
  items     ThreePackItem[]

  @@index([companyId])
  @@map("three_pack_rules")
}

model ThreePackItem {
  id        String        @id @default(cuid())
  ruleId    String
  rule      ThreePackRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  role      ThreePackRole
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Quantity in colis.
  colis     Decimal       @db.Decimal(14, 3)
  /// PRICE rules, GIVE (target) items: the new price per colis.
  price     Decimal?      @db.Decimal(14, 2)

  @@index([ruleId])
  @@index([productId])
  @@map("three_pack_items")
}


/// "Client closed" report from a van phone: the driver reached the client's
/// shop, found it shut and photographed it (one or several photos). Created
/// offline on the phone, synced later; idempotent by opId.
model ClosedVisit {
  id         String               @id @default(cuid())
  companyId  String
  company    Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// The van the driver was on.
  locationId String?
  location   Store?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  opId       String?
  note       String?
  /// Where the phone was when the photo was taken.
  lat        Float?
  lng        Float?
  /// Real action time on the phone (not the sync time).
  occurredAt DateTime
  createdAt  DateTime             @default(now())
  photos     ClosedVisitPhoto[]

  @@unique([companyId, opId])
  @@index([companyId, occurredAt])
  @@index([customerId])
  @@map("closed_visits")
}

model ClosedVisitPhoto {
  id        String      @id @default(cuid())
  visitId   String
  visit     ClosedVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int         @default(0)

  @@index([visitId])
  @@map("closed_visit_photos")
}


/// Recurring tour: one van + one weekday + one sector, every week or every 2
/// weeks, with no end date. The daily Tournee rows (stamps, stops, sales) are
/// generated from it on demand. A van+weekday "cell" holds up to two plans.
model TourneePlan {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  locationId    String
  location      Store    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  secteurId     String?
  secteur       Secteur? @relation(fields: [secteurId], references: [id], onDelete: SetNull)
  /// 0 = Sunday … 6 = Saturday (Algiers calendar).
  weekday       Int
  /// 1 = every week, 2 = every 2 weeks.
  intervalWeeks Int      @default(1)
  /// First occurrence, "YYYY-MM-DD". Biweekly weeks are counted from here.
  anchorKey     String
  /// Slot inside the van+weekday cell (0 or 1).
  slot          Int      @default(0)
  /// Hand-picked ordered client ids (JSON array). Null = every active client
  /// of the sector, always up to date.
  clientIds     String?
  /// Single dates removed from the plan ("YYYY-MM-DD,YYYY-MM-DD") — never recreated.
  skips         String   @default("")
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  tournees      Tournee[]

  @@index([companyId, isActive])
  @@index([locationId, weekday])
  @@map("tournee_plans")
}


/// Position history of a van phone (the always-on location service). The
/// "last position" on the Store stays the fast path; this is the trail.
model VanPosition {
  id         String   @id @default(cuid())
  companyId  String
  vanId      String
  van        Store    @relation(fields: [vanId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  accuracy   Float?
  speed      Float?
  /// When the phone took the fix (not when it reached the server).
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([vanId, recordedAt])
  @@index([companyId, recordedAt])
  @@map("van_positions")
}
